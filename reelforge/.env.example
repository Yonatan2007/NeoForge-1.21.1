# Stock footage works with no keys (Mixkit is built in, Free-license clips only).
# Optional extra sources:
# Pexels: https://www.pexels.com/api/  (free, 200 req/hour)
PEXELS_API_KEY=
# Pixabay: https://pixabay.com/api/docs/  (free, key shown when logged in)
PIXABAY_API_KEY=

# Higgsfield voice to use (a voice_id from the connector's list_voices).
HIGGSFIELD_VOICE_ID=

# Optional: headless Higgsfield REST route (`--tts higgsfield-api`), experimental.
# Credentials from https://console.higgsfield.ai as "key_id:key_secret".
HF_KEY=
HIGGSFIELD_TTS_ENDPOINT=

# Optional tuning
WHISPER_MODEL=base.en      # tiny.en | base.en | small.en | medium.en
WHISPER_DEVICE=cpu         # or cuda
REELFORGE_CACHE=           # default ~/.cache/reelforge
